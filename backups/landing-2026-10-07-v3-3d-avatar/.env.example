# Laravel API base URL (including /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public URL of this React site (canonical URLs, Open Graph, sitemap)
VITE_SITE_URL=http://localhost:5173

# Optional hero 3D model (.glb/.gltf, Draco supported). Put the file in public/models/
# and set e.g. /models/developer-avatar.glb. Leave empty to use the built-in avatar.
VITE_AVATAR_MODEL_URL=
